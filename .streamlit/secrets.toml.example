# =====================================================================
#  TEMPLATE ONLY – contains no real secrets.
#
#  Online (Streamlit Community Cloud):
#     App -> ⋮ -> Settings -> Secrets -> paste the filled-in text there.
#  On your own computer:
#     copy this file to  .streamlit/secrets.toml  and fill it in.
#     (.streamlit/secrets.toml is in .gitignore, so git will not upload it.)
# =====================================================================

# --- 1. Earth Engine service-account key ------------------------------
# Open the JSON key you downloaded from Google Cloud and copy each value.
# Keep the triple quotes around private_key exactly as shown.
[gee_credentials]
type = "service_account"
project_id = "your-gee-project-id"
private_key_id = "0000000000000000000000000000000000000000"
private_key = """-----BEGIN PRIVATE KEY-----
PASTE-THE-KEY-LINES-HERE
-----END PRIVATE KEY-----
"""
client_email = "your-service-account@your-gee-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gee-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# --- 2. (optional) Where the data lives --------------------------------
# Leave this out to use the folder written in settings.toml.
# Set it when the data moves to another Earth Engine account/project –
# no code change is needed.
# [gee]
# asset_folder = "projects/your-gee-project-id/assets/GW_Analysis_Example"
# project = "your-gee-project-id"
